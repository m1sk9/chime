[system]
log_level = "info"
tick_interval_sec = 30
timezone = "Asia/Tokyo"

[[reminders]]
name = "daily-standup"
time = "09:30"
days = ["mon", "tue", "wed", "thu", "fri"]
message = "Time for the daily standup."
webhook = "team"
thread_id = "1234567890123456789"       # optional; a thread in the webhook's channel.
                                        # Quote it: a snowflake is a string, not a number.

[[reminders]]
name = "weekly-review"
time = "17:00"
days = ["fri"]
message = "Don't forget the weekly review."
webhook = "team"

[[reminders]]
name = "salary-day"
time = "15:00"
day_of_month = [18]         # 1..=31; use e.g. [1, 15] for multiple days.
                            # A reminder uses either `days` or `day_of_month`, never both.
message = "Payday is here."
webhook = "team"

# Status pages to watch. chime polls each page's public incident document and
# forwards new incident updates to Discord; it never receives an inbound webhook,
# so no ports need to be exposed.
[[status_pages]]
name = "claude"                         # non-empty, unique within the file
kind = "statuspage"                     # optional; statuspage | instatus | incidentio |
                                        # datadog | custom (default: statuspage)
url = "https://status.claude.com"       # https only; the page's base URL
webhook = "team"                        # logical name — resolved via env, as above
thread_id = "1234567890123456789"       # optional; same as for reminders
display_name = "Claude Status"          # optional; shown as the Discord username
                                        # (default: the `name` above)

[[status_pages]]
name = "proton"
url = "https://status.proton.me"
webhook = "team"
display_name = "Proton Status"
poll_interval_sec = 600                 # optional; 60..=3600 (default: 300)
min_impact = "major"                    # optional; none | maintenance | minor |
                                        # major | critical (default: none)
avatar_url = "https://example.com/proton.png"   # optional

[[status_pages]]
name = "instatus"
kind = "instatus"
url = "https://instat.us"               # chime appends /v3/summary.json
webhook = "team"

[[status_pages]]
name = "incidentio"
kind = "incidentio"
url = "https://status.incident.io"      # chime appends /feed.atom; the feed has no
webhook = "team"                        # severity, so min_impact has no effect

[[status_pages]]
name = "shopist"
kind = "datadog"
url = "https://shopist.statuspage.datadoghq.com"   # chime appends /config.json
webhook = "team"

[[status_pages]]
name = "my-service"
kind = "custom"
url = "https://status.example.com/incidents.json" # requested as written
webhook = "team"
# Required with kind = "custom". `incidents` is from the document root (omit it
# when the document is the array); the rest are relative to one incident. Only
# `id` and `title` are required.
mapping = { incidents = "/incidents", id = "/id", title = "/title", status = "/state", body = "/message", updated_at = "/updated_at", link = "/url", impact = "/severity" }

# Release feeds to watch. The first poll records the current version; after
# that, every change of version is posted as one embed.
[[watches]]
name = "firefox"                        # non-empty, unique within [[watches]]
webhook = "team"                        # logical name — resolved via env, as above
source = { kind = "firefox" }           # channel: release | esr | beta | devedition |
                                        # nightly (default: release)
display_name = "Firefox Releases"       # optional (default: the source label)

[[watches]]
name = "chrome"
webhook = "team"
source = { kind = "chrome", platform = "win", channel = "stable", rollout = "started" }
                                        # rollout: started | complete (default: started)
poll_interval_sec = 1800                # optional; 60..=3600 (default: 3600)

# Syndication feeds to subscribe to: RSS, Atom or JSON Feed, detected from the body.
# The first poll records the current entries; after that, every entry not seen
# before is posted as one embed.
[[rss]]
name = "claude-code-changelog"          # non-empty, unique within [[rss]]
url = "https://code.claude.com/docs/en/changelog/rss.xml"
                                        # https only; the feed URL itself
webhook = "team"                        # logical name — resolved via env, as above
display_name = "Claude Code Changelog"  # optional (default: the `name` above)
poll_interval_sec = 900                 # optional; 60..=3600 (default: 900)
