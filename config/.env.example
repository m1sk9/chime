# The env key for each webhook is derived from its logical name in config.toml:
#   webhook = "team"      -> CHIME_WEBHOOK_TEAM
#   webhook = "on-call"   -> CHIME_WEBHOOK_ON_CALL
#   webhook = "ops.alpha" -> CHIME_WEBHOOK_OPS_ALPHA
# Non-alphanumeric characters are replaced with '_' and the result is uppercased.
#
# When using Docker secrets, set <KEY>_FILE to the secret file path instead:
#   CHIME_WEBHOOK_TEAM_FILE=/run/secrets/chime_webhook_team

CHIME_WEBHOOK_TEAM=https://discord.com/api/webhooks/XXXXXX/YYYYYY
