{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chime-docs",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "chime.m1sk9.dev", "custom_domain": true }],
  "compatibility_flags": ["nodejs_compat"]
}
